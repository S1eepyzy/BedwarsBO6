<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.bwbo6</groupId>
    <artifactId>BedWarsBO6</artifactId>
    <version>2.1.1</version>
    <packaging>jar</packaging>

    <name>BedWarsBO6</name>
    <description>BedWars 极速轮换攻防 BO6 模式（Minecraft 1.8.9 / Spigot 1.8.8）</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <spigot.version>1.8.8-R0.1-SNAPSHOT</spigot.version>
        <!-- ProGuard 的 Java 运行时 library。必须指向真实存在的 JDK8 rt.jar
             （本机 IDEA 自带的 Corretto 1.8.0_442）。可用 -Dproguard.rt.jar=... 覆盖。
             注意：不能写 ${java.home}，因为 Maven 若跑在 JDK9+ 上根本没有 rt.jar。 -->
        <proguard.rt.jar>C:\Users\zzz\.jdks\corretto-1.8.0_442-1\jre\lib\rt.jar</proguard.rt.jar>
    </properties>

    <repositories>
        <repository>
            <id>spigot-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- 服务端 API（由服务器提供，不打包） -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>${spigot.version}</version>
            <scope>provided</scope>
            <!-- 排除 bungeecord-chat：离线环境解析不到 net.md-5:1.8-SNAPSHOT。
                 本插件源码不使用 net.md_5.bungee.*，编译不依赖它；运行期由服务器自带提供。 -->
            <exclusions>
                <exclusion>
                    <groupId>net.md-5</groupId>
                    <artifactId>bungeecord-chat</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- SQLite 驱动（storage_mode=SQLITE 生效，打包进插件） -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.45.3.0</version>
        </dependency>

        <!-- MySQL 驱动（storage_mode=MYSQL 生效，打包进插件） -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.33</version>
        </dependency>

        <!-- Redis 客户端（可选缓存，打包进插件，缺失时自动降级内存缓存） -->
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
            <version>3.10.0</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>BedWarsBO6-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.10.1</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                打包后混淆（ProGuard）：在同一 package 阶段、shade 之后执行。
                默认直接处理 target/${project.build.finalName}.jar（此时已是 shade 产物）
                并原地覆盖为目标 jar；关闭优化只做收缩+改名混淆。
                规则见 proguard-bwbo6.pro。跳过可执行：mvn package -Dproguard.skip=true
            -->
            <plugin>
                <groupId>com.github.wvengen</groupId>
                <artifactId>proguard-maven-plugin</artifactId>
                <version>2.7.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>proguard</goal>
                        </goals>
                        <configuration>
                            <!-- shade 出的 fat jar 较大，给 ProGuard 单独加大堆 -->
                            <maxMemory>768m</maxMemory>
                            <!-- 混淆映射表 / seed：仅写文件名，插件会自动放到 outputDirectory(target/) 下。
                                 写成绝对路径会被插件再拼一次 outputDirectory，导致 target\E:\...\target\ 翻倍错误 -->
                            <mappingFileName>proguard_map.txt</mappingFileName>
                            <seedFileName>proguard_seed.txt</seedFileName>
                            <!-- 追加到 ProGuard 命令行的兜底选项：
                                 fat jar 内第三方库引用的可选类(如 slf4j binder)未打包会产生
                                 unresolved 告警，ProGuard 默认因此中止；-ignorewarnings 让
                                 它继续输出混淆 jar（-dontnote 关掉重复定义刷屏）。 -->
                            <options>
                                <option>-ignorewarnings</option>
                                <option>-dontnote</option>
                            </options>
                            <libs>
                                <!-- Java 运行时类（识别 Runnable/Enum 等层级，避免误改名）。
                                     必须指向 JDK8 的 rt.jar（见 properties.proguard.rt.jar）。 -->
                                <lib>${proguard.rt.jar}</lib>
                            </libs>
                            <proguardInclude>${project.basedir}/proguard-bwbo6.pro</proguardInclude>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
